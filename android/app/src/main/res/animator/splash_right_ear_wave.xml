<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1700"
    android:repeatCount="-1"
    android:repeatMode="restart">
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <!-- Two quick waves followed by a one-second rest. The sequence keeps
             repeating until Flutter draws its first frame. -->
        <keyframe
            android:fraction="0"
            android:value="0" />
        <keyframe
            android:fraction="0.0824"
            android:interpolator="@android:interpolator/linear_out_slow_in"
            android:value="13" />
        <keyframe
            android:fraction="0.2059"
            android:interpolator="@android:interpolator/fast_out_slow_in"
            android:value="0" />
        <keyframe
            android:fraction="0.2882"
            android:interpolator="@android:interpolator/linear_out_slow_in"
            android:value="13" />
        <keyframe
            android:fraction="0.4118"
            android:interpolator="@android:interpolator/fast_out_slow_in"
            android:value="0" />
        <keyframe
            android:fraction="1"
            android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
